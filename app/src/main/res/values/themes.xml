<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Knotwork" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Platform splash theme (Android 12+ splash screen API).

        The platform stage is the launch colour and nothing else: the wordmark
        is drawn exactly once, by the in-app loading page, which weaves it from
        a blank frame. Drawing it in both stages made the hand-off jump — the
        platform icon is a 288 dp plate with a 192 dp glyph, the loading page
        draws it at min(288 dp, 45% of the screen height) from 0% opacity —
        The loading page paints `brand_mark.png` through `PixelStrokePainter`;
        `brand_startup_mark_animated` is no longer mounted by this theme.
        `postSplashScreenTheme` swaps to the regular app theme as soon as
        `installSplashScreen()` releases its keep-on-screen condition.
    -->
    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Knotwork</item>
    </style>
</resources>
